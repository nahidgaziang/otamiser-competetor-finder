---
import { queryHub } from '../../lib/db';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { formatDate, initial } from '../../lib/article';

let comparisons: any[] = [];
try {
  const res = await queryHub(`
    SELECT article_id, slug, competitor_name, canonical_domain, competitor_summary, hub_published_at
    FROM app.published_articles
    ORDER BY competitor_name ASC
  `);
  comparisons = res.rows;
} catch (e) {
  console.error('Hub query failed:', e);
  comparisons = [];
}
---

<PublicLayout
  title="Compare Otamiser | Revenue management software comparisons"
  description="Side-by-side comparisons of Otamiser and other revenue management and dynamic pricing tools for short-term rentals and hotels."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Comparisons</p>
      <h1>How Otamiser compares</h1>
      <p class="lead">
        Side-by-side comparisons of Otamiser and other revenue management and dynamic pricing tools for
        short-term rentals and hotels, written from each vendor's public product information.
      </p>
    </div>
  </section>

  <div class="wrap hub">
    {comparisons.length === 0 ? (
      <p class="empty">No comparisons have been published yet. Check back soon.</p>
    ) : (
      <>
        <p class="count">{comparisons.length} {comparisons.length === 1 ? 'comparison' : 'comparisons'}</p>
        <ul class="grid">
          {comparisons.map((c) => (
            <li>
              <a href={`/compare/${c.slug}`} class="card">
                <span class="card-head">
                  <span class="mono" aria-hidden="true">{initial(c.competitor_name)}</span>
                  <span>
                    <span class="card-title">Otamiser vs {c.competitor_name}</span>
                    <span class="card-domain">{c.canonical_domain}</span>
                  </span>
                </span>
                <span class="card-summary">
                  {c.competitor_summary || `How Otamiser and ${c.competitor_name} compare on features, pricing and fit.`}
                </span>
                <span class="card-foot">
                  <span class="card-date">{formatDate(c.hub_published_at) ?? ''}</span>
                  <span class="card-link" aria-hidden="true">Read comparison →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</PublicLayout>

<style>
  .hub { padding-top: 2.25rem; }
  .count { margin: 0 0 1rem; color: var(--muted); font-size: 0.9rem; }
  .empty { padding: 2.5rem 1.5rem; text-align: center; color: var(--muted); background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .grid li { display: flex; }
  .card { flex: 1; display: flex; flex-direction: column; gap: 0.9rem; padding: 1.35rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: border-color 0.15s, transform 0.15s; }
  .card:hover { border-color: var(--brand); color: inherit; }
  @media (prefers-reduced-motion: no-preference) { .card:hover { transform: translateY(-2px); } }
  .card-head { display: flex; align-items: center; gap: 0.8rem; }
  .card-title { display: block; font-weight: 700; color: var(--ink); line-height: 1.3; }
  .card-domain { display: block; font-size: 0.82rem; color: var(--muted); }
  .card-summary { color: var(--text); font-size: 0.95rem; line-height: 1.55; flex: 1; }
  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding-top: 0.85rem; border-top: 1px solid var(--border); font-size: 0.85rem; }
  .card-date { color: var(--muted); }
  .card-link { color: var(--brand); font-weight: 650; }
</style>
