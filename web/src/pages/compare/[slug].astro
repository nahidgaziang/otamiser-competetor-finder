---
import { queryHub } from '../../lib/db';
import PublicLayout from '../../layouts/PublicLayout.astro';
import RichText from '../../components/RichText.astro';
import FeatureCell from '../../components/FeatureCell.astro';
import { formatDate, initial, list, safeHref, type Category, type Row } from '../../lib/article';

const { slug } = Astro.params;

let article: any = null;
try {
  // Only published articles are visible (the view filters on status = 'published').
  const res = await queryHub(
    `
    SELECT slug, competitor_name, canonical_domain, content, hub_published_at, version_created_at
    FROM app.published_articles
    WHERE slug = $1
    LIMIT 1
  `,
    [slug],
  );
  if (res.rows.length > 0) article = res.rows[0];
} catch (err) {
  console.error('Error fetching article slug:', err);
}

if (!article) {
  return Astro.redirect('/compare');
}

const content = article.content || {};
const competitor: string = article.competitor_name;
const title: string = content.title || `Otamiser vs ${competitor}`;
const metaDesc: string = content.meta_description || `Comparison between Otamiser and ${competitor}.`;
const updated = formatDate(article.hub_published_at || article.version_created_at);

const differences = list<{ title?: string; paragraphs?: unknown }>(content.differences);
const categories = list<Category>(content.comparison_table);
const faqs = list<{ question?: string; answer?: unknown }>(content.faqs);
const has = (v: unknown) => list(v).length > 0;

const ctaHref = safeHref(content.cta_button_url) ?? 'https://www.otamiser.com/';
---

<PublicLayout title={`${title} | Otamiser`} description={metaDesc}>
  <section class="hero">
    <div class="wrap narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/compare">All comparisons</a><span aria-hidden="true">/</span><span>{competitor}</span>
      </nav>
      <p class="eyebrow">Software comparison</p>
      <h1>{title}</h1>
      <p class="lead">{metaDesc}</p>
      <div class="versus" aria-label="Products compared">
        <div class="vs-chip">
          <span class="mono mono-us" aria-hidden="true">O</span>
          <span><strong>Otamiser</strong><small>otamiser.com</small></span>
        </div>
        <span class="vs" aria-hidden="true">vs</span>
        <div class="vs-chip">
          <span class="mono" aria-hidden="true">{initial(competitor)}</span>
          <span><strong>{competitor}</strong><small>{article.canonical_domain}</small></span>
        </div>
      </div>
      {updated && <p class="byline">Updated {updated}</p>}
    </div>
  </section>

  <article class="wrap article">
    {has(content.intro) && (
      <div class="intro">
        <RichText paras={content.intro} />
      </div>
    )}

    {(has(content.competitor_overview) || has(content.baseline_overview)) && (
      <section aria-labelledby="overview">
        <h2 id="overview">The two products at a glance</h2>
        <div class="overview-grid">
          <div class="panel panel-us">
            <h3>What Otamiser does</h3>
            <RichText paras={content.baseline_overview} />
          </div>
          <div class="panel">
            <h3>What {competitor} does</h3>
            <RichText paras={content.competitor_overview} />
          </div>
        </div>
      </section>
    )}

    {differences.length > 0 && (
      <section aria-labelledby="differences">
        <h2 id="differences">Key differences</h2>
        <ol class="diffs">
          {differences.map((d) => (
            <li class="diff">
              <h3>{d?.title}</h3>
              <RichText paras={d?.paragraphs} />
            </li>
          ))}
        </ol>
      </section>
    )}

    {categories.length > 0 && (
      <section aria-labelledby="features">
        <h2 id="features">Feature comparison</h2>
        <div class="table-scroll" role="region" aria-labelledby="features" tabindex="0">
          <table class="ftable">
            <caption class="sr-only">Features of Otamiser and {competitor}, grouped by category</caption>
            <thead>
              <tr>
                <th scope="col">Feature</th>
                <th scope="col" class="col-us">Otamiser</th>
                <th scope="col">{competitor}</th>
              </tr>
            </thead>
            {categories.map((cat) => (
              <tbody>
                {cat?.category_name && (
                  <tr class="cat">
                    <th scope="colgroup" colspan="3">{cat.category_name}</th>
                  </tr>
                )}
                {list<Row>(cat?.rows).map((row) => (
                  <tr>
                    <th scope="row">{row?.feature_name}</th>
                    <td class="col-us"><FeatureCell cell={row?.baseline_cell} /></td>
                    <td><FeatureCell cell={row?.competitor_cell} /></td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </section>
    )}

    {has(content.who_is_it_for) && (
      <section aria-labelledby="who">
        <h2 id="who">Which one is right for you?</h2>
        <div class="panel"><RichText paras={content.who_is_it_for} /></div>
      </section>
    )}

    {has(content.pricing_analysis) && (
      <section aria-labelledby="pricing">
        <h2 id="pricing">Pricing</h2>
        <RichText paras={content.pricing_analysis} />
      </section>
    )}

    {has(content.results_impact) && (
      <section aria-labelledby="results">
        <h2 id="results">Results and impact</h2>
        <RichText paras={content.results_impact} />
      </section>
    )}

    {faqs.length > 0 && (
      <section aria-labelledby="faq">
        <h2 id="faq">Frequently asked questions</h2>
        <div class="faqs">
          {faqs.map((f, i) => (
            <details class="faq" open={i === 0}>
              <summary>{f?.question}</summary>
              <div class="faq-body"><RichText paras={f?.answer} /></div>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="cta" aria-labelledby="cta">
      <h2 id="cta">{content.cta_heading || 'See how Otamiser fits your portfolio'}</h2>
      <p>{content.cta_description || 'Connect daily ranking tracking with automated dynamic pricing.'}</p>
      <a class="btn" href={ctaHref} rel="noopener noreferrer">{content.cta_button_text || 'Book a demo'}</a>
    </section>
  </article>
</PublicLayout>

<style>
  .versus { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 1.75rem; }
  .vs-chip { display: flex; align-items: center; gap: 0.7rem; padding: 0.55rem 1rem 0.55rem 0.55rem; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow); }
  .vs-chip strong { display: block; line-height: 1.25; }
  .vs-chip small { display: block; color: var(--muted); font-size: 0.8rem; line-height: 1.3; }
  .vs { font-size: 0.85rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .byline { margin: 1.25rem 0 0; font-size: 0.875rem; color: var(--muted); }

  .narrow, .article { max-width: 860px; }
  .article { padding-top: 2.5rem; }
  .article section { margin-top: 3rem; }
  .article h2 { font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem); margin: 0 0 1.1rem; }
  .article h3 { font-size: 1.15rem; margin: 0 0 0.6rem; }
  .article p { margin: 0 0 1rem; }
  .article p:last-child { margin-bottom: 0; }
  .intro p { font-size: 1.125rem; }

  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.35rem 1.5rem; }
  .panel-us { background: var(--brand-soft); border-color: color-mix(in srgb, var(--brand) 30%, var(--border)); }
  .overview-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }

  .diffs { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; counter-reset: diff; }
  .diff { counter-increment: diff; position: relative; padding: 1.35rem 1.5rem 1.35rem 4.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); box-shadow: var(--shadow); }
  .diff::before { content: counter(diff); position: absolute; left: 1.35rem; top: 1.25rem; width: 1.9rem; height: 1.9rem; display: grid; place-items: center; border-radius: 999px; background: var(--brand); color: var(--brand-ink); font-weight: 700; font-size: 0.9rem; }

  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .ftable { width: 100%; min-width: 300px; border-collapse: collapse; font-size: 0.95rem; }
  .ftable th, .ftable td { padding: 0.8rem 1rem; text-align: left; vertical-align: middle; border-bottom: 1px solid var(--border); }
  .ftable thead th { background: var(--surface); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .ftable thead th.col-us { color: var(--brand); }
  .ftable tbody th[scope='row'] { font-weight: 550; color: var(--ink); width: 44%; }
  .ftable td { width: 28%; }
  .ftable .col-us { background: color-mix(in srgb, var(--brand-soft) 55%, transparent); }
  .ftable tr.cat th { background: var(--surface-2); color: var(--ink); font-size: 0.85rem; font-weight: 700; padding-block: 0.55rem; }
  .ftable tbody:last-child tr:last-child > * { border-bottom: 0; }

  .faqs { display: grid; gap: 0.75rem; }
  .faq { border: 1px solid var(--border); border-radius: 12px; background: var(--bg); }
  .faq summary { cursor: pointer; list-style: none; padding: 1rem 3rem 1rem 1.25rem; font-weight: 650; color: var(--ink); position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); font-size: 1.35rem; font-weight: 400; color: var(--brand); }
  .faq[open] summary::after { content: '\2212'; }
  .faq-body { padding: 0 1.25rem 1.1rem; }

  .cta { margin-top: 3.5rem; padding: 2.25rem 1.75rem; border-radius: var(--radius); text-align: center; background: var(--ink); color: var(--bg); }
  .cta h2 { color: var(--bg); margin-bottom: 0.6rem; }
  .cta p { max-width: 52ch; margin: 0 auto 1.5rem; color: color-mix(in srgb, var(--bg) 80%, var(--ink)); }

  @media (max-width: 560px) {
    .diff { padding: 1.15rem 1.15rem 1.15rem 3.6rem; }
    .diff::before { left: 1rem; top: 1.05rem; }
    .panel { padding: 1.15rem; }
    .ftable { font-size: 0.875rem; }
    .ftable th, .ftable td { padding: 0.65rem 0.5rem; }
    .ftable th:first-child { padding-left: 0.75rem; }
    .ftable tbody th[scope='row'] { width: 40%; }
    .ftable td { width: 30%; }
    .ftable thead th { font-size: 0.7rem; letter-spacing: 0.03em; }
    .ftable :global(.mark) { padding-right: 0.45rem; font-size: 0.8rem; }
    .ftable :global(.cell-text) { font-size: 0.85rem; }
  }
</style>
