---
import { queryAdmin } from '../../lib/db';

let stats = {
  competitors: 0,
  candidates: 0,
  articles: 0,
  published: 0,
  ai_spend: 0.0,
};

let recentJobs: any[] = [];

try {
  const compRes = await queryAdmin(`
    SELECT 
      COUNT(*) as total,
      COUNT(*) FILTER (WHERE status = 'candidate') as candidates
    FROM app.competitors;
  `);
  stats.competitors = parseInt(compRes.rows[0].total || '0');
  stats.candidates = parseInt(compRes.rows[0].candidates || '0');

  const artRes = await queryAdmin(`
    SELECT 
      COUNT(*) as total,
      COUNT(*) FILTER (WHERE status = 'published') as published
    FROM app.articles;
  `);
  stats.articles = parseInt(artRes.rows[0].total || '0');
  stats.published = parseInt(artRes.rows[0].published || '0');

  const spendRes = await queryAdmin(`
    SELECT COALESCE(SUM(cost_usd), 0) as spend FROM app.llm_calls;
  `);
  stats.ai_spend = parseFloat(spendRes.rows[0].spend || '0');

  const jobsRes = await queryAdmin(`
    SELECT id, kind, status, attempts, created_at, error
    FROM app.jobs
    ORDER BY created_at DESC
    LIMIT 6;
  `);
  recentJobs = jobsRes.rows;
} catch (e) {
  console.error("Admin dashboard fetch error:", e);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | Competitor Intelligence</title>
    <style>
      :root {
        --bg: #0f172a;
        --card: #1e293b;
        --text: #f8fafc;
        --muted: #94a3b8;
        --accent: #3b82f6;
        --border: #334155;
        --green: #22c55e;
        --amber: #f59e0b;
        --red: #ef4444;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        display: flex;
        min-height: 100vh;
      }
      aside {
        width: 240px;
        background: #090d16;
        border-right: 1px solid var(--border);
        padding: 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .brand { font-size: 1.1rem; font-weight: 700; color: white; margin-bottom: 2rem; padding-left: 0.5rem; }
      nav a {
        display: block;
        padding: 0.65rem 0.75rem;
        color: var(--muted);
        text-decoration: none;
        border-radius: 6px;
        margin-bottom: 0.4rem;
        font-size: 0.95rem;
      }
      nav a:hover, nav a.active {
        background: var(--card);
        color: white;
      }
      main {
        flex: 1;
        padding: 2.5rem;
        overflow-y: auto;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
      }
      h1 { font-size: 1.75rem; margin: 0; }
      .grid-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2.5rem;
      }
      .stat-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.25rem;
      }
      .stat-card .label { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.5rem; }
      .stat-card .val { font-size: 1.75rem; font-weight: 700; }
      .stat-card .meta { font-size: 0.8rem; margin-top: 0.4rem; }
      .section-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.5rem;
      }
      h2 { font-size: 1.25rem; margin-top: 0; margin-bottom: 1rem; }
      table { width: 100%; border-collapse: collapse; text-align: left; }
      th, td { padding: 0.75rem; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
      th { color: var(--muted); font-weight: 600; }
      .badge {
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
      }
      .badge-queued { background: #1e3a8a; color: #93c5fd; }
      .badge-running { background: #78350f; color: #fde68a; }
      .badge-completed { background: #064e3b; color: #6ee7b7; }
      .badge-failed { background: #7f1d1d; color: #fca5a5; }
    </style>
  </head>
  <body>
    <aside>
      <div>
        <div class="brand">Otamiser Engine</div>
        <nav>
          <a href="/admin" class="active">Dashboard</a>
          <a href="/admin/candidates">Candidates ({stats.candidates})</a>
          <a href="/admin/articles">Articles ({stats.articles})</a>
          <a href="/admin/jobs">Job Queue</a>
          <a href="/admin/validation">Verification (V1–V12)</a>
          <a href="/compare" target="_blank">Public Hub &nearr;</a>
        </nav>
      </div>
      <div>
        <a href="/admin/login" style="color: var(--muted); font-size: 0.85rem; text-decoration: none;">Sign Out</a>
      </div>
    </aside>

    <main>
      <header>
        <div>
          <h1>Operational Overview</h1>
          <p style="color: var(--muted); margin: 0.25rem 0 0 0; font-size: 0.9rem;">Real-time intelligence engine status and queue metrics.</p>
        </div>
      </header>

      <div class="grid-stats">
        <div class="stat-card">
          <div class="label">Total Competitors</div>
          <div class="val">{stats.competitors}</div>
          <div class="meta" style="color: var(--green);">{stats.competitors - stats.candidates} cataloged</div>
        </div>
        <div class="stat-card">
          <div class="label">Candidates to Review</div>
          <div class="val" style="color: var(--amber);">{stats.candidates}</div>
          <div class="meta"><a href="/admin/candidates" style="color: var(--accent); text-decoration: none;">Review queue &rarr;</a></div>
        </div>
        <div class="stat-card">
          <div class="label">Comparisons Published</div>
          <div class="val">{stats.published} / {stats.articles}</div>
          <div class="meta" style="color: var(--muted);">Human publish only</div>
        </div>
        <div class="stat-card">
          <div class="label">AI Inference Spend</div>
          <div class="val">${stats.ai_spend.toFixed(4)}</div>
          <div class="meta" style="color: var(--green);">Hard cap: $5.0000 USD</div>
        </div>
      </div>

      <div class="section-card">
        <h2>Recent Background Jobs</h2>
        {recentJobs.length === 0 ? (
          <p style="color: var(--muted); font-size: 0.9rem;">No background jobs recorded yet.</p>
        ) : (
          <table>
            <thead>
              <tr>
                <th>Job ID</th>
                <th>Kind</th>
                <th>Status</th>
                <th>Attempts</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              {recentJobs.map((j) => (
                <tr>
                  <td style="font-family: monospace;">{j.id.slice(0, 8)}...</td>
                  <td><strong>{j.kind}</strong></td>
                  <td><span class={`badge badge-${j.status}`}>{j.status}</span></td>
                  <td>{j.attempts}</td>
                  <td style="color: var(--muted);">{new Date(j.created_at).toLocaleTimeString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </main>
  </body>
</html>

