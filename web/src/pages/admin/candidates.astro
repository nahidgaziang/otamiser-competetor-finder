---
import { queryAdmin } from '../../lib/db';

let candidates: any[] = [];
try {
  const res = await queryAdmin(`
    SELECT id, name, canonical_domain, relevance_score, summary, evidence_quote, created_at
    FROM app.competitors
    WHERE status = 'candidate'
    ORDER BY relevance_score DESC NULLS LAST, created_at DESC;
  `);
  candidates = res.rows;
} catch (e) {
  console.error("Failed to load candidates:", e);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Candidate Queue | Competitor Intelligence</title>
    <style>
      :root {
        --bg: #0f172a;
        --card: #1e293b;
        --text: #f8fafc;
        --muted: #94a3b8;
        --accent: #3b82f6;
        --border: #334155;
        --green: #22c55e;
        --red: #ef4444;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        display: flex;
        min-height: 100vh;
      }
      aside {
        width: 240px;
        background: #090d16;
        border-right: 1px solid var(--border);
        padding: 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .brand { font-size: 1.1rem; font-weight: 700; color: white; margin-bottom: 2rem; padding-left: 0.5rem; }
      nav a {
        display: block;
        padding: 0.65rem 0.75rem;
        color: var(--muted);
        text-decoration: none;
        border-radius: 6px;
        margin-bottom: 0.4rem;
        font-size: 0.95rem;
      }
      nav a:hover, nav a.active { background: var(--card); color: white; }
      main { flex: 1; padding: 2.5rem; overflow-y: auto; }
      h1 { font-size: 1.75rem; margin: 0 0 0.5rem 0; }
      p.sub { color: var(--muted); margin: 0 0 2rem 0; font-size: 0.95rem; }
      .candidate-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.75rem;
      }
      .name { font-size: 1.25rem; font-weight: 700; color: white; }
      .domain { color: var(--accent); font-size: 0.9rem; margin-top: 0.2rem; }
      .score {
        background: #064e3b;
        color: #6ee7b7;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .summary { color: #cbd5e1; font-size: 0.95rem; margin-bottom: 1rem; }
      .quote-box {
        background: #0f172a;
        border-left: 3px solid var(--accent);
        padding: 0.75rem 1rem;
        font-style: italic;
        color: var(--muted);
        font-size: 0.85rem;
        margin-bottom: 1.25rem;
      }
      .actions { display: flex; gap: 0.75rem; }
      button {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
      }
      .btn-approve { background: var(--green); color: black; }
      .btn-skip { background: transparent; border-color: var(--border); color: var(--muted); }
      .btn-skip:hover { background: var(--border); color: white; }
    </style>
  </head>
  <body>
    <aside>
      <div>
        <div class="brand">Otamiser Engine</div>
        <nav>
          <a href="/admin">Dashboard</a>
          <a href="/admin/candidates" class="active">Candidates ({candidates.length})</a>
          <a href="/admin/articles">Articles</a>
          <a href="/admin/jobs">Job Queue</a>
          <a href="/admin/validation">Verification (V1–V12)</a>
          <a href="/compare" target="_blank">Public Hub &nearr;</a>
        </nav>
      </div>
      <div>
        <a href="/admin/login" style="color: var(--muted); font-size: 0.85rem; text-decoration: none;">Sign Out</a>
      </div>
    </aside>

    <main>
      <h1>Discovered Competitor Candidates</h1>
      <p class="sub">Review newly discovered candidates. Approving enqueues deep crawling and evidence extraction.</p>

      {candidates.length === 0 ? (
        <div class="candidate-card" style="text-align: center; color: var(--muted);">
          No candidates pending review. Run discovery from the jobs console to surface new competitors.
        </div>
      ) : (
        candidates.map((c) => (
          <div class="candidate-card">
            <div class="card-header">
              <div>
                <div class="name">{c.name}</div>
                <div class="domain">{c.canonical_domain}</div>
              </div>
              <div class="score">Score: {Math.round((c.relevance_score || 0.5) * 100)}%</div>
            </div>

            <div class="summary">{c.summary}</div>

            {c.evidence_quote && (
              <div class="quote-box">
                &ldquo;{c.evidence_quote}&rdquo;
              </div>
            )}

            <div class="actions">
              <form method="POST" action="/api/candidate-action">
                <input type="hidden" name="competitor_id" value={c.id} />
                <input type="hidden" name="action" value="approve" />
                <button type="submit" class="btn-approve">Approve &amp; Start Research</button>
              </form>

              <form method="POST" action="/api/candidate-action">
                <input type="hidden" name="competitor_id" value={c.id} />
                <input type="hidden" name="action" value="skip" />
                <button type="submit" class="btn-skip">Skip</button>
              </form>
            </div>
          </div>
        ))
      )}
    </main>
  </body>
</html>

