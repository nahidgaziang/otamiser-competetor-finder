# =============================================================================
# otamiser-prototype Environment Configuration Template (.env.example)
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# PostgreSQL 18 Local Configuration (127.0.0.1:5432)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database Role Connection Strings (scram-sha-256)
DATABASE_URL=
DATABASE_URL_MIGRATOR=
DATABASE_URL_PIPELINE=
DATABASE_URL_WEB=

# AI Model Inference (Spend Cap $5.00)
ANTHROPIC_API_KEY=
AI_SPEND_CAP_USD=5.00

# Search & Research APIs (Optional / Fallbacks)
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Webflow Safe Client (Test Site Only, never production)
WEBFLOW_MODE=off
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_ID=

# Web App & Admin Authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4321

# Slack Webhook (Optional)
SLACK_WEBHOOK_URL=

